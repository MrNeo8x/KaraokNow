{
  "name": "karaokenow-backend",
  "version": "0.1.0",
  "private": true,
  "description": "KaraokeNow modular monolith backend",
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "db:migrate": "node --env-file-if-exists=.env node_modules/node-pg-migrate/bin/node-pg-migrate.js up -m migrations",
    "db:rollback": "node --env-file-if-exists=.env node_modules/node-pg-migrate/bin/node-pg-migrate.js down -m migrations",
    "bench:booking": "node -r ts-node/register scripts/benchmark-booking.ts",
    "db:seed:uat": "node --env-file-if-exists=.env -r ts-node/register scripts/seed-uat.ts",
    "openapi:generate": "node -r ts-node/register scripts/generate-openapi.ts",
    "openapi:check": "node -r ts-node/register scripts/generate-openapi.ts --check",
    "api:docs": "node scripts/generate-api-markdown.cjs",
    "api:docs:check": "node scripts/generate-api-markdown.cjs --check",
    "outbox:work": "node -r ts-node/register scripts/run-outbox-worker.ts",
    "holds:expire": "node -r ts-node/register scripts/run-hold-expiry-worker.ts",
    "test": "jest",
    "test:e2e": "NODE_OPTIONS=--experimental-vm-modules jest --config test/jest-e2e.config.cjs --runInBand",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "verify": "npm run build && npm test -- --runInBand && npm run openapi:check && npm run api:docs:check"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.6",
    "@nestjs/jwt": "^11.0.1",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/swagger": "^11.2.1",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/core": "^3.1.1",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.301.2",
    "@opentelemetry/instrumentation-express": "^0.73.0",
    "@opentelemetry/instrumentation-http": "^0.301.2",
    "@opentelemetry/instrumentation-pg": "^0.78.0",
    "@opentelemetry/sdk-node": "^0.301.2",
    "@opentelemetry/sdk-trace": "^3.1.1",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/testing": "^11.1.6",
    "@testcontainers/postgresql": "^11.7.2",
    "@types/express": "^5.0.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.6",
    "@types/supertest": "^6.0.3",
    "jest": "^30.2.0",
    "node-pg-migrate": "^8.0.4",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
