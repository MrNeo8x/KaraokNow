# Copy this file to .env for local development. Never commit real secrets.
DATABASE_URL=postgresql://karaokenow:karaokenow_local_only@localhost:5433/karaokenow
POSTGRES_PORT=5433
JWT_SECRET=replace-with-at-least-32-random-characters
PORT=3000
# Public UAT abuse controls. Defaults shown; tune only with observed UAT traffic.
PUBLIC_RATE_LIMIT_WINDOW_MINUTES=15
PUBLIC_HOLD_IP_LIMIT=20
PUBLIC_HOLD_PHONE_LIMIT=5
PUBLIC_LOOKUP_IP_LIMIT=60
PUBLIC_LOOKUP_PHONE_LIMIT=10
# Set to the exact number of trusted reverse-proxy hops in UAT/production; keep 0 for direct local access.
TRUST_PROXY_HOPS=0
# Client IP for public rate limits (OPS-007). Leave empty locally. On Vercel use a header the edge overwrites
# (x-real-ip or x-vercel-forwarded-for) after checking GET /v1/internal/diag/client-ip with the CRON_SECRET.
CLIENT_IP_HEADER=
# Optional: when the FE proxy forwards the browser IP in X-KN-Client-IP, it must send this secret in X-KN-Proxy-Secret (>= 16 chars).
CLIENT_IP_PROXY_SECRET=
# Staff refresh cookie kn_refresh (FE-012). Keep unset (Secure) on Vercel; set false only for plain-HTTP local stacks.
AUTH_COOKIE_SECURE=
# File storage (PD-037). Leave empty locally: files go to STORAGE_LOCAL_DIR (default be/.storage) and public files are
# served at /v1/files/public/*. On Vercel connect the stores with a read-write token:
#   vn-karaoke-now-blob-pub -> BLOB_PUBLIC_READ_WRITE_TOKEN (BLOB_READ_WRITE_TOKEN also accepted)
#   vn-karaoke-now-blob-pri -> BLOB_PRIVATE_READ_WRITE_TOKEN
BLOB_PUBLIC_READ_WRITE_TOKEN=
BLOB_PRIVATE_READ_WRITE_TOKEN=
STORAGE_LOCAL_DIR=
# Set to false in production to disable the Swagger UI at /docs (OPS-005). Defaults to enabled.
SWAGGER_ENABLED=true
# PostgreSQL pool and timeouts (OPS-004). Defaults shown; tune per environment and re-run `npm run bench:booking`.
PG_POOL_MAX=10
PG_CONNECTION_TIMEOUT_MS=5000
PG_IDLE_TIMEOUT_MS=30000
PG_STATEMENT_TIMEOUT_MS=15000
PG_LOCK_TIMEOUT_MS=5000
PG_IDLE_IN_TRANSACTION_TIMEOUT_MS=60000
OTEL_SERVICE_NAME=karaokenow-backend
# Optional. Leave unset locally to keep trace context active without exporting spans.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
